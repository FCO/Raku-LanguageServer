use Test;
use Raku::LanguageServer::Transport;

# Round-trips messages through a temp file, exercising the Content-Length
# framing on both the write and read paths, including multi-byte UTF-8 bodies.

my $path = $*TMPDIR.add("rls-transport-{$*PID}.bin");
my $null = $*SPEC.devnull.IO;

{
    # The write handle has to be closed too: Windows will not delete a file that
    # any handle still holds open.
    my $write-fh = $path.open(:w);
    my $t = Raku::LanguageServer::Transport.new(:out($write-fh), :in($null.open(:r)));
    $t.write-message({ :jsonrpc('2.0'), :id(1), :method('initialize'),
                       :params({ :emoji('snow ☃ party 🎉') }) });
    $t.write-message({ :jsonrpc('2.0'), :id(2), :method('shutdown') });
    $write-fh.close;
}

my $read-fh = $path.open(:r);

my $reader = Raku::LanguageServer::Transport.new(:in($read-fh), :out($null.open(:w)));
my $m1 = $reader.read-message;
my $m2 = $reader.read-message;
my $m3 = $reader.read-message;

is $m1<method>, 'initialize', 'first message method survives framing';
is $m1<params><emoji>, 'snow ☃ party 🎉', 'multi-byte UTF-8 body round-trips intact';
is $m2<method>, 'shutdown', 'second message read correctly';
nok $m3.defined, 'clean EOF returns an undefined message';

$read-fh.close;

$path.unlink;

done-testing;
